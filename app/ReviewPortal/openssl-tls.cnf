# Include the candidate Azure Linux 3 vendor configuration unchanged.
# The image build checks this layout and its openssl_init entry point.
.include /etc/pki/tls/openssl.cnf

[default]
config_diagnostics = 1

# Extend the vendor initialization section without replacing provider/EVP settings.
[openssl_init]
ssl_conf = reviewportal_ssl

[reviewportal_ssl]
system_default = reviewportal_tls

[reviewportal_tls]
MinProtocol = TLSv1.2
MaxProtocol = TLSv1.2
CipherString = ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-GCM-SHA256
Groups = P-256:P-384
